#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXN 100005

int main() {
    int n, k;
    scanf("%d", &n);
    scanf("%d", &k);

    // 用数组标记是否已激活并记录激活时间
    int *activated = (int *)calloc(n, sizeof(int)); // 0 表示未激活
    int *queue = (int *)malloc(n * sizeof(int));
    int front = 0, rear = 0;

    // 读取初始激活位置并去重
    for (int i = 0; i < k; i++) {
        int pos;
        scanf("%d", &pos);
        if (pos >= 0 && pos < n && activated[pos] == 0) {
            activated[pos] = 1; // 时间 1 激活
            queue[rear++] = pos;
        }
    }

    int maxTime = 1; // 初始激活传感器的时间为 1

    // BFS 模拟传播
    while (front < rear) {
        int cur = queue[front++];
        int curTime = activated[cur];
        if (curTime > maxTime) maxTime = curTime;

        // 向左传播
        if (cur - 1 >= 0 && activated[cur - 1] == 0) {
            activated[cur - 1] = curTime + 1;
            queue[rear++] = cur - 1;
        }
        // 向右传播
        if (cur + 1 < n && activated[cur + 1] == 0) {
            activated[cur + 1] = curTime + 1;
            queue[rear++] = cur + 1;
        }
    }

    printf("%d\n", maxTime);

    free(activated);
    free(queue);
    return 0;
}